{
  "name": "@ucdjs/ucd-fields",
  "version": "0.0.1-beta.1",
  "description": "All UCD file fields",
  "type": "module",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "homepage": "https://github.com/ucdjs/ucd-fields#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ucdjs/ucd-fields.git"
  },
  "bugs": "https://github.com/ucdjs/ucd-fields/issues",
  "keywords": [
    "unicode",
    "ucd",
    "ucdjs",
    "character",
    "database",
    "fields"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./v10": "./dist/v10.js",
    "./v11": "./dist/v11.js",
    "./v12": "./dist/v12.js",
    "./v12.1": "./dist/v12.1.js",
    "./v13": "./dist/v13.js",
    "./v14": "./dist/v14.js",
    "./v15": "./dist/v15.js",
    "./v15.1": "./dist/v15.1.js",
    "./v16": "./dist/v16.js",
    "./v4.1": "./dist/v4.1.js",
    "./v5": "./dist/v5.js",
    "./v5.1": "./dist/v5.1.js",
    "./v5.2": "./dist/v5.2.js",
    "./v6": "./dist/v6.js",
    "./v6.1": "./dist/v6.1.js",
    "./v6.2": "./dist/v6.2.js",
    "./v6.3": "./dist/v6.3.js",
    "./v7": "./dist/v7.js",
    "./v8": "./dist/v8.js",
    "./v9": "./dist/v9.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "gen:fields": "ucd codegen fields --bundle \"./src/v{version}.ts\""
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@ucdjs/cli": "catalog:pipelines",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
